{
  "name": "tasks-api-cicd",
  "version": "1.0.0",
  "private": true,
  "description": "API educativa lista para construir pipelines CI/CD",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "node --test test/unit/*.test.js",
    "test:integration": "node --test test/integration/*.test.js",
    "test:e2e": "node --test test/e2e/*.test.js",
    "coverage": "c8 --check-coverage --lines 75 --branches 65 npm test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "openapi:lint": "redocly lint openapi.yaml",
    "docs:build": "mkdirp dist/docs && redocly build-docs openapi.yaml -o dist/docs/index.html",
    "audit:ci": "npm audit --audit-level=high --omit=dev",
    "sbom": "cyclonedx-npm --output-file dist/sbom.cdx.json --output-format JSON"
  },
  "dependencies": {
    "express": "^4.21.2",
    "pg": "^8.13.3"
  },
  "devDependencies": {
    "@cyclonedx/cyclonedx-npm": "^4.0.0",
    "@redocly/cli": "^1.0.0",
    "@testcontainers/postgresql": "^10.0.0",
    "c8": "^10.1.3",
    "eslint": "^8.57.1",
    "mkdirp": "^3.0.1",
    "prettier": "^3.4.2"
  }
}
